<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Danh sách Album"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(Click → Sửa | Long press → Xóa)"
        android:textSize="12sp"
        android:textColor="#888"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- ⭐ QUAN TRỌNG [Buổi 3 - BT17]: ListView bắt cả 2 sự kiện:
         1. setOnItemClickListener (Chạm nhẹ -> Mở màn hình Sửa Album và gửi dữ liệu qua Intent)
         2. setOnItemLongClickListener (Nhấn giữ -> Hiện AlertDialog xác nhận Xóa Album) -->
    <ListView
        android:id="@+id/lvAlbums"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#BDBDBD"
        android:dividerHeight="1dp" />

</LinearLayout>
