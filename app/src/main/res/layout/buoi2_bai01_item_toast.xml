<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ QUAN TRỌNG [Buổi 2 - BT01]: Layout con dùng riêng cho Custom Toast (được nạp bằng LayoutInflater.inflate() rồi gán vào toast.setView(layout)) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#333333">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍳"
        android:textSize="30sp"
        android:layout_marginEnd="12dp" />

    <!-- ⭐ QUAN TRỌNG: ID txtToastMessage dùng để gán nội dung thông báo động từ Java thông qua layout.findViewById(R.id.txtToastMessage) -->
    <TextView
        android:id="@+id/txtToastMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_gravity="center_vertical" />

</LinearLayout>
