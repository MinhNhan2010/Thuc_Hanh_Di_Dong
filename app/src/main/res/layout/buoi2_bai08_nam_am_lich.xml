<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bài 8: Đổi năm Dương lịch → Âm lịch"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp" />

    <!-- ⭐ QUAN TRỌNG [Buổi 2 - BT08]: Chỉ cho phép nhập số nguyên dương (inputType="number") để tính Can (nam % 10) và Chi (nam % 12) -->
    <EditText
        android:id="@+id/edtNamDuong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập năm dương lịch (>=1900)"
        android:inputType="number"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnChuyenDoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chuyển đổi"
        android:layout_marginTop="12dp"
        android:textAllCaps="false" />

    <!-- ⭐ QUAN TRỌNG: TextView hiển thị kết quả Năm Âm lịch (Can + Chi) -->
    <TextView
        android:id="@+id/tvKetQua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Năm Âm lịch: "
        android:textSize="22sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="#FFEB3B" />

</LinearLayout>
