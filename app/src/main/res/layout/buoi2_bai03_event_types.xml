<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="Bài 3: Các kiểu lập trình sự kiện"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ⭐ QUAN TRỌNG [Buổi 2 - BT03]: android:inputType="number" mở bàn phím số nguyên khi người dùng nhập số A và số B -->
    <EditText
        android:id="@+id/edtSoA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Nhập số A"
        android:inputType="number" />

    <EditText
        android:id="@+id/edtSoB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Nhập số B"
        android:inputType="number" />

    <!-- ⭐ QUAN TRỌNG: TextView hiển thị kết quả tính toán -->
    <TextView
        android:id="@+id/tvKetQua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#E0E0E0"
        android:padding="12dp"
        android:text="Kết quả: "
        android:textColor="#0000FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ⭐ QUAN TRỌNG - Kiểu 1 (OnClick in XML): Có thuộc tính android:onClick="onClickTong" gọi thẳng vào hàm trong Activity -->
    <Button
        android:id="@+id/btnTong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:onClick="onClickTong"
        android:text="Tổng 2 số (OnClick XML)"
        android:textAllCaps="false" />

    <!-- ⭐ QUAN TRỌNG - Kiểu 2..5: Không dùng android:onClick mà bắt sự kiện trong Java bằng 4 kỹ thuật khác nhau -->
    <Button
        android:id="@+id/btnHieu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hiệu 2 số (Anonymous Listener)"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnTich"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tích 2 số (Activity is Listener)"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnThuong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Thương 2 số (Listener Variable)"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnUCSLN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ƯCLN (Explicit Listener Class)"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnThoat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#f44336"
        android:text="Thoát chương trình"
        android:textAllCaps="false"
        android:textColor="#ffffff" />

</LinearLayout>
