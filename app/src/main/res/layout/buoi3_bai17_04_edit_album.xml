<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa Album"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- ⭐ QUAN TRỌNG [Buổi 3 - BT17]: android:enabled="false" khóa ô Mã Album lại, không cho người dùng sửa khóa định danh khi cập nhật -->
    <EditText
        android:id="@+id/edtMaAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mã Album"
        android:enabled="false" />

    <EditText
        android:id="@+id/edtTenAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên Album"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/edtCaSi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ca sĩ"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Update"
        android:textAllCaps="false"
        android:layout_marginTop="12dp" />

</LinearLayout>
