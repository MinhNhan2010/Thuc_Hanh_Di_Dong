<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ QUAN TRỌNG [Buổi 3 - BT18]: Layout dùng chung cho cả 2 chế độ: THÊM NHÂN VIÊN và SỬA/XÓA NHÂN VIÊN -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ⭐ QUAN TRỌNG: tvTitle thay đổi động từ Java ("Thêm nhân viên mới" hoặc "Chỉnh sửa nhân viên") tùy theo mode nhận từ Intent -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm nhân viên"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/edtMaNV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã nhân viên" />

        <EditText
            android:id="@+id/edtHoTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ tên"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/edtChucVu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chức vụ"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/edtLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lương (VNĐ)"
            android:inputType="number"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phòng ban:"
            android:layout_marginTop="8dp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPhongBan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbIT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbKeToan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kế toán" />

            <RadioButton
                android:id="@+id/rbNhanSu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhân sự" />

            <RadioButton
                android:id="@+id/rbKinhDoanh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KD" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnLuu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾 Lưu"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp" />

            <!-- ⭐ QUAN TRỌNG: Nút Xóa (btnXoa) sẽ bị ẩn đi bằng btnXoa.setVisibility(View.GONE) khi đang ở chế độ Thêm mới, và chỉ hiện lên khi ở chế độ Sửa -->
            <Button
                android:id="@+id/btnXoa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ Xóa"
                android:background="#f44336"
                android:textColor="#ffffff"
                android:textAllCaps="false"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
