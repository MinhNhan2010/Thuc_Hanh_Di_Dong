<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ QUAN TRỌNG [Buổi 3 - BT17]: Layout này dùng android:layout_height="wrap_content" vì Activity được cấu hình Theme.Dialog trong AndroidManifest.xml (hiển thị dạng hộp thoại nổi) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm Album mới"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/edtMaAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mã Album" />

    <EditText
        android:id="@+id/edtTenAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên Album"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/edtCaSi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ca sĩ"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnLuuAlbum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 Lưu Album"
            android:textAllCaps="false"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnXoaTrang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔄 Xóa trắng"
            android:textAllCaps="false"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
