<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <Button
        android:id="@+id/btnAddClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="➕ Thêm lớp học mới"
        android:textAllCaps="false" />

    <!-- ⭐ QUAN TRỌNG [Buổi 4 - BT19 ClassList]: Thanh tìm kiếm lớp học realtime (gắn TextWatcher trong Java để truy vấn LIKE %...% trong SQLite) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/edtSearchClass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="🔍 Tìm theo mã lớp hoặc tên lớp..."
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnClearSearchClass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa"
            android:textAllCaps="false"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvClassCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh sách lớp học"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:padding="8dp"
        android:background="#BBDEFB"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Chạm vào lớp để xem DS sinh viên • Nhấn giữ để Sửa/Xóa"
        android:textSize="12sp"
        android:textColor="#666666"
        android:paddingVertical="4dp" />

    <!-- ⭐ QUAN TRỌNG: ListView hiển thị danh sách lớp bằng MyAdapterClass (buoi4_bai19_05_item_class) và đăng ký ContextMenu (buoi4_bai19_menu_class) -->
    <ListView
        android:id="@+id/lvClass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="#BDBDBD"
        android:dividerHeight="1dp" />

</LinearLayout>
