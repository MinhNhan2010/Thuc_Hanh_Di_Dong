<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bài 18: Quản lý nhân sự"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(Intent, startActivityForResult)"
        android:textSize="12sp"
        android:textColor="#888"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- ⭐ QUAN TRỌNG [Buổi 3 - BT18]: Nút mở Bai18EditNVActivity bằng startActivityForResult(intent, REQUEST_ADD) -->
    <Button
        android:id="@+id/btnThemNV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="➕ Thêm nhân viên mới"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/tvTongNV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng: 0 nhân viên"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:padding="8dp"
        android:background="#BBDEFB"
        android:layout_marginTop="8dp" />

    <!-- ⭐ QUAN TRỌNG: Chạm vào nhân viên trên ListView sẽ mở lại Bai18EditNVActivity kèm mode="edit" và nhận kết quả trả về qua onActivityResult -->
    <ListView
        android:id="@+id/lvNhanVien"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="#BDBDBD"
        android:dividerHeight="1dp" />

</LinearLayout>
